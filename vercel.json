{
  "version": 2,
  "installCommand": "corepack enable && corepack prepare pnpm@10 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "PORT=5173 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/mushaf-prayer build",
  "outputDirectory": "artifacts/mushaf-prayer/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
